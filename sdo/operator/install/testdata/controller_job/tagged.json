{
  "metadata": {
    "name": "sdo-controller-run",
    "namespace": "demo-sdo",
    "creationTimestamp": null
  },
  "spec": {
    "podFailurePolicy": {
      "rules": [
        {
          "action": "Ignore",
          "onExitCodes": null,
          "onPodConditions": [
            {
              "type": "DisruptionTarget",
              "status": "True"
            }
          ]
        }
      ]
    },
    "backoffLimit": 6,
    "template": {
      "metadata": {
        "creationTimestamp": null,
        "labels": {
          "app.kubernetes.io/name": "sdo-controller"
        }
      },
      "spec": {
        "volumes": [
          {
            "name": "repository",
            "persistentVolumeClaim": {
              "claimName": "repository"
            }
          },
          {
            "name": "scratch",
            "emptyDir": {
              "sizeLimit": "4Gi"
            }
          },
          {
            "name": "credentials",
            "secret": {
              "secretName": "credentials"
            }
          }
        ],
        "initContainers": [
          {
            "name": "prepare-build-cache",
            "image": "sdo-controller:tag",
            "command": [
              "mkdir",
              "-p",
              "/workspace/.sdo-runtime/build/tmp",
              "/workspace/.sdo-runtime/build/go-tmp",
              "/workspace/.sdo-runtime/build/go-cache"
            ],
            "resources": {
              "limits": {
                "cpu": "100m",
                "memory": "64Mi"
              },
              "requests": {
                "cpu": "10m",
                "memory": "16Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "repository",
                "mountPath": "/workspace"
              }
            ],
            "securityContext": {
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true,
              "allowPrivilegeEscalation": false
            }
          }
        ],
        "containers": [
          {
            "name": "controller",
            "image": "sdo-controller:tag",
            "command": [
              "/usr/local/bin/sdo-operator"
            ],
            "args": [
              "controller",
              "--app",
              "/workspace/application",
              "--namespace",
              "demo",
              "--application",
              "demo",
              "--responder-image",
              "responder:test",
              "--toolchain-image",
              "sdo-controller:tag",
              "--prober-image",
              "sdo-controller:tag",
              "--repository-pvc",
              "repository",
              "--repository-mount-path",
              "/workspace",
              "--credentials-secret",
              "credentials",
              "--worktree-root",
              "/workspace/worktrees",
              "--response-timeout",
              "60s",
              "--verification-timeout",
              "300s",
              "--control-namespace",
              "demo-sdo",
              "--broker-mode=native",
              "--worker-mount-mode=proposal-only",
              "--validator-image",
              "sdo-detector-validator:tag",
              "--model",
              "gpt-test",
              "--responder-backend",
              "codex",
              "--reflection-session",
              "resume",
              "--reflection-guidance",
              "baseline",
              "--supervise"
            ],
            "envFrom": [
              {
                "secretRef": {
                  "name": "credentials"
                }
              }
            ],
            "env": [
              {
                "name": "SDO_RESPONDER_MENU",
                "value": "0"
              },
              {
                "name": "CODEX_HOME",
                "value": "/workspace/.sdo-runtime/codex"
              },
              {
                "name": "CLAUDE_CONFIG_DIR",
                "value": "/workspace/.sdo-runtime/claude"
              },
              {
                "name": "TMPDIR",
                "value": "/workspace/.sdo-runtime/build/tmp"
              },
              {
                "name": "GOTMPDIR",
                "value": "/workspace/.sdo-runtime/build/go-tmp"
              },
              {
                "name": "GOCACHE",
                "value": "/workspace/.sdo-runtime/build/go-cache"
              },
              {
                "name": "SDO_OBSERVATION_CEILING",
                "value": "{\"version\":0,\"targets\":null}"
              },
              {
                "name": "SDO_GO_CACHE_SEED",
                "value": "/go/build-cache"
              },
              {
                "name": "SDO_TURN_USAGE_LOG",
                "value": "/workspace/.sdo-runtime/usage/controller-turns.jsonl"
              },
              {
                "name": "SDO_CONTROLLER_JOB",
                "value": "sdo-controller-run"
              },
              {
                "name": "SDO_CONTROLLER_POD_UID",
                "valueFrom": {
                  "fieldRef": {
                    "fieldPath": "metadata.uid"
                  }
                }
              },
              {
                "name": "GIT_AUTHOR_NAME",
                "value": "sdo-controller"
              },
              {
                "name": "GIT_AUTHOR_EMAIL",
                "value": "sdo-controller@invalid"
              },
              {
                "name": "GIT_COMMITTER_NAME",
                "value": "sdo-controller"
              },
              {
                "name": "GIT_COMMITTER_EMAIL",
                "value": "sdo-controller@invalid"
              }
            ],
            "resources": {
              "limits": {
                "cpu": "2",
                "memory": "4Gi"
              },
              "requests": {
                "cpu": "250m",
                "memory": "512Mi"
              }
            },
            "volumeMounts": [
              {
                "name": "repository",
                "mountPath": "/workspace"
              },
              {
                "name": "scratch",
                "mountPath": "/tmp"
              },
              {
                "name": "credentials",
                "readOnly": true,
                "mountPath": "/sdo/credentials"
              }
            ],
            "imagePullPolicy": "IfNotPresent",
            "securityContext": {
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true,
              "allowPrivilegeEscalation": false
            }
          }
        ],
        "restartPolicy": "Never",
        "serviceAccountName": "sdo-controller",
        "securityContext": {
          "runAsUser": 65532,
          "runAsNonRoot": true,
          "fsGroup": 65532,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        }
      }
    },
    "ttlSecondsAfterFinished": 600
  },
  "status": {}
}
