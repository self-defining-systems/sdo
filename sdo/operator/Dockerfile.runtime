# syntax=docker/dockerfile:1.7

FROM golang:1.26.8-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS go-modules
WORKDIR /opt/sdo
# Seed for the in-pod detector build. The runtime has no C compiler, so Go
# builds there with cgo off; cache keys include that setting.
ENV GOCACHE=/go/build-cache \
    CGO_ENABLED=0
# Module downloads and the third-party build cache depend on the manifests
# alone, so a Go source edit leaves every layer up to go-deps cached.
COPY sdo/operator/go.mod sdo/operator/go.sum ./sdo/operator/
COPY sdo/operator/contracts/go.mod sdo/operator/contracts/go.sum ./sdo/operator/contracts/
COPY sdo/operator/core/go.mod sdo/operator/core/go.sum ./sdo/operator/core/
COPY sdo/operator/runtime/go.mod sdo/operator/runtime/go.sum ./sdo/operator/runtime/
COPY sdo/operator/sdk/go.mod sdo/operator/sdk/go.sum ./sdo/operator/sdk/
RUN for dir in sdo/operator/sdk sdo/operator/core sdo/operator/runtime sdo/operator; do \
      (cd "$dir" && go mod download all); \
    done

# The package names are the only thing that leaves this stage, so go-deps stays
# cached until an import is added or removed.
FROM go-modules AS go-dep-list
COPY sdo/operator ./sdo/operator
RUN mkdir /deps \
    && for dir in sdo/operator/sdk sdo/operator/core sdo/operator/runtime sdo/operator; do \
      (cd "$dir" && go list -deps -test ./... | grep -vE '^sdo\.dev|[ ]|\.test$' | sort -u) > "/deps/$(echo "$dir" | tr / _).txt"; \
    done

FROM go-modules AS go-deps
# Bound shared-host build parallelism, including nested compiler jobs.
ENV GOMAXPROCS=8 GOFLAGS="-p=8"
COPY --from=go-dep-list /deps /deps
RUN for dir in sdo/operator/sdk sdo/operator/core sdo/operator/runtime sdo/operator; do \
      (cd "$dir" && go build $(cat "/deps/$(echo "$dir" | tr / _).txt")); \
    done \
    && (cd /go/build-cache && find . -type f | LC_ALL=C sort) > /go/build-cache.files

FROM registry.k8s.io/kubectl:v1.33.2@sha256:15ac68dd5ff1c5ef4c5ef85f2ef1a6e20903312ed10090e0c834ca8b156e331e AS kubectl

FROM node:22.17.0-bookworm-slim@sha256:b04ce4ae4e95b522112c2e5c52f781471a5cbc3b594527bcddedee9bc48c03a0 AS node-tools

FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8 AS runtime-base
# The identical OS/tool layer is shared by every shipped role. Go and build
# dependencies stay in build stages; controller and validator share compiler layers.
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git python3 python3-pip bash curl jq tar \
    && rm -rf /var/lib/apt/lists/*
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl
ENV PATH="/usr/local/go/bin:${PATH}" \
    PYTHONPATH=/opt/sdo \
    GIT_AUTHOR_NAME="SDO Agent" \
    GIT_AUTHOR_EMAIL="sdo-agent@sdo.dev" \
    GIT_COMMITTER_NAME="SDO Agent" \
    GIT_COMMITTER_EMAIL="sdo-agent@sdo.dev" \
    HOME=/tmp \
    GOCACHE=/tmp/go-cache \
    GOMODCACHE=/go/pkg/mod \
    GOPROXY=off \
    GOSUMDB=off \
    GOMAXPROCS=2 \
    GOFLAGS="-mod=mod -p=2" \
    CGO_ENABLED=0 \
    SDO_GO_CACHE_SEED=/go/build-cache \
    SDO_PLAYBOOK_PROGRAM_EXAMPLE_DIR=/opt/sdo/examples/playbook-programs
WORKDIR /opt/sdo

FROM runtime-base AS python-deps
RUN python3 -m pip install --break-system-packages --no-cache-dir --no-deps \
      agentshim==0.7.0 \
      annotated-types==0.7.0 \
      anyio==4.12.1 \
      attrs==25.4.0 \
      charset-normalizer==3.4.4 \
      requests==2.32.5 \
      urllib3==2.6.3 \
      certifi==2026.1.4 \
      cffi==2.0.0 \
      click==8.3.1 \
      cryptography==46.0.4 \
      h11==0.16.0 \
      httpcore==1.0.9 \
      httpx==0.28.1 \
      httpx-sse==0.4.3 \
      idna==3.11 \
      jsonschema==4.26.0 \
      jsonschema-specifications==2025.9.1 \
      mcp==1.26.0 \
      protobuf==6.33.4 \
      protobuf-py==0.6.0 \
      protobuf-py-ext==0.6.0 \
      protovalidate==2.0.0 \
      pycparser==3.0 \
      pydantic==2.12.5 \
      pydantic-core==2.41.5 \
      pydantic-settings==2.12.0 \
      pyjwt==2.10.1 \
      python-dotenv==1.2.1 \
      python-multipart==0.0.22 \
      pyyaml==6.0.3 \
      referencing==0.37.0 \
      rpds-py==0.30.0 \
      sse-starlette==3.2.0 \
      starlette==0.50.0 \
      typing-extensions==4.15.0 \
      typing-inspection==0.4.2 \
      uvicorn==0.40.0

FROM python-deps AS model-deps
# Node is needed by model CLIs, never by controller, validator or scripted jobs.
RUN apt-get update && apt-get install --yes --no-install-recommends libstdc++6 jq \
    && printf '%s\n' '{"probe":[{"ok":true}]}' | jq -e '.probe[0].ok == true' >/dev/null \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node-tools /usr/local/bin/node /usr/local/bin/node
COPY --from=node-tools /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ARG CODEX_VERSION=0.163.0
ARG CLAUDE_CODE_VERSION=2.1.258
RUN npm install --global "@openai/codex@${CODEX_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force

FROM go-deps AS go-runtime
# The runtime and synthesized detector workspaces use local Go modules in this
# tree, including memory, worker registration, and generated contracts.
COPY sdo/operator ./sdo/operator
RUN cd sdo/operator/sdk && go test -run '^$' ./... && go vet ./...
RUN cd sdo/operator/core && go test -run '^$' ./... && go vet ./...
RUN cd sdo/operator/runtime && go test -run '^$' ./...
# Vet the production dependency graph through a neutral consumer. Worker and
# runtime test-only packages are not dependencies of generated validators.
RUN mkdir sdo/operator/runtime/cachewarm \
    && printf 'package cachewarm\nimport (_ "sdo.dev/operator/runtime"; _ "sdo.dev/operator/runtime/prometheus"; _ "sdo.dev/operator/runtime/prober"; _ "sdo.dev/operator/runtime/replay")\n' > sdo/operator/runtime/cachewarm/cachewarm.go \
    && (cd sdo/operator/runtime && go vet ./cachewarm) \
    && rm -rf sdo/operator/runtime/cachewarm
RUN cd sdo/operator && go build -buildvcs=false -ldflags="-s -w" -o /usr/local/bin/sdo-go-cache ./cmd/sdo-go-cache
RUN cd sdo/operator && go build -buildvcs=false -ldflags="-s -w" -o /usr/local/bin/sdo-operator ./cmd/sdo-operator
RUN cd sdo/operator/runtime && go build -buildvcs=false -ldflags="-s -w" -o /usr/local/bin/sdo-observation-check ./cmd/sdo-observation-check
# Cache entries added on top of go-deps, so the worker image copies only these.
RUN mkdir /go/build-cache-delta \
    && cd /go/build-cache \
    && find . -type f | LC_ALL=C sort | LC_ALL=C comm -13 /go/build-cache.files - \
      | tar -cf - -T - | tar -xf - -C /go/build-cache-delta


FROM runtime-base AS runtime-sources
COPY --from=go-runtime /usr/local/bin/sdo-operator /usr/local/bin/sdo-operator
COPY --from=go-runtime /usr/local/bin/sdo-observation-check /usr/local/bin/sdo-observation-check
COPY --from=go-runtime /opt/sdo/sdo/operator /opt/sdo/sdo/operator

FROM runtime-sources AS controller
COPY --from=go-deps /usr/local/go /usr/local/go
COPY --from=go-deps /go/pkg/mod /go/pkg/mod
COPY --from=go-deps /go/build-cache /go/build-cache
COPY --from=go-runtime /go/build-cache-delta/ /go/build-cache/
COPY sdo/agents/registrations /opt/sdo/sdo/agents/registrations
LABEL org.opencontainers.image.title="SDO Go operator" org.opencontainers.image.version="0.1.0"
CMD ["/usr/local/bin/sdo-operator", "controller", "--help"]

# Compiler/module/dependency layers are shared with controller. Application
# source never enters these stages; only SDK changes rebuild the cache delta.
FROM runtime-base AS validator-toolchain
COPY --from=go-deps /usr/local/go /usr/local/go
COPY --from=go-deps /go/pkg/mod /go/pkg/mod
COPY --from=go-deps /go/build-cache /go/build-cache
COPY --from=go-runtime /go/build-cache-delta/ /go/build-cache/
COPY --from=go-runtime /usr/local/bin/sdo-go-cache /usr/local/bin/sdo-go-cache
ENV GOCACHEPROG=/usr/local/bin/sdo-go-cache
# Fail the image build if compiler, SDK cache, or module seed is absent.
RUN test -x /usr/local/go/bin/go && test -x /usr/local/bin/sdo-go-cache \
    && test -d /go/pkg/mod/k8s.io && test -n "$(find /go/build-cache -name '*-a' -print -quit)"

FROM validator-toolchain AS validator
COPY --from=go-runtime /usr/local/bin/sdo-operator /usr/local/bin/sdo-operator
COPY --from=go-runtime /opt/sdo/sdo/operator /opt/sdo/sdo/operator
ARG SDO_VALIDATOR_SCHEMA_IDENTITY="unknown"
LABEL org.opencontainers.image.title="SDO detector validator" \
      org.opencontainers.image.version="0.1.0" \
      dev.sdo.validator-schema="${SDO_VALIDATOR_SCHEMA_IDENTITY}"
CMD ["/usr/local/bin/sdo-operator", "validate", "--help"]

FROM model-deps AS worker-runtime
COPY --from=go-runtime /usr/local/bin/sdo-operator /usr/local/bin/sdo-operator
COPY --from=go-runtime /opt/sdo/sdo/operator /opt/sdo/sdo/operator
COPY examples/playbook-programs /opt/sdo/examples/playbook-programs
COPY sdo /opt/sdo/sdo
COPY libs/__init__.py /opt/sdo/libs/__init__.py
COPY libs/agent_cli /opt/sdo/libs/agent_cli
RUN test -f /opt/sdo/sdo/skills/sdo-memory/SKILL.md \
    && test -f /opt/sdo/sdo/skills/sdo-incident-response/SKILL.md \
    && test -f /opt/sdo/sdo/skills/sdo-detector-authoring/SKILL.md \
    && test -f /opt/sdo/sdo/skills/sdo-playbook-authoring/SKILL.md \
    && command -v sdo-operator
RUN printf '#!/bin/sh\nexec python3 -m sdo.agents.responder.tools_cli "$@"\n' > /usr/local/bin/sdo \
    && chmod 755 /usr/local/bin/sdo
RUN /usr/local/bin/sdo-operator memory help | grep -q 'memory check'
CMD ["python3", "-m", "sdo.agents.responder.worker"]

FROM worker-runtime AS responder

# Scripted lanes share Python dependencies, without ever adding model CLIs.
FROM python-deps AS scripted-runtime
COPY --from=go-runtime /usr/local/bin/sdo-operator /usr/local/bin/sdo-operator
COPY --from=go-runtime /opt/sdo/sdo/operator /opt/sdo/sdo/operator
COPY examples/playbook-programs /opt/sdo/examples/playbook-programs
COPY sdo /opt/sdo/sdo
COPY libs/__init__.py /opt/sdo/libs/__init__.py
COPY libs/agent_cli /opt/sdo/libs/agent_cli
RUN test -f /opt/sdo/sdo/skills/sdo-memory/SKILL.md \
    && test -f /opt/sdo/sdo/skills/sdo-incident-response/SKILL.md \
    && test -f /opt/sdo/sdo/skills/sdo-detector-authoring/SKILL.md \
    && test -f /opt/sdo/sdo/skills/sdo-playbook-authoring/SKILL.md \
    && command -v sdo-operator
RUN printf '#!/bin/sh\nexec python3 -m sdo.agents.responder.tools_cli "$@"\n' > /usr/local/bin/sdo \
    && chmod 755 /usr/local/bin/sdo
RUN /usr/local/bin/sdo-operator memory help | grep -q 'memory check'
CMD ["python3", "-m", "sdo.agents.responder.worker"]

# Fixed slim tools for RunScript; no model CLI, compiler, module cache or sources.
FROM debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8 AS script-tools-base
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates bash curl jq tar \
    && rm -rf /var/lib/apt/lists/*
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl
FROM script-tools-base AS script-tools
COPY --from=go-runtime /usr/local/bin/sdo-operator /usr/local/bin/sdo-operator
CMD ["/usr/local/bin/sdo-operator", "script-runner"]
