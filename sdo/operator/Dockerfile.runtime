# syntax=docker/dockerfile:1.7

FROM golang:1.26.8-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS go-runtime
WORKDIR /opt/sdo
# Seed for the controller's in-pod detector build. The runtime has no C
# compiler, so Go builds there with cgo off; cache keys include that setting.
ENV GOCACHE=/go/build-cache \
    CGO_ENABLED=0
# The runtime and synthesized detector workspaces use local Go modules in this
# tree, including memory, worker registration, and generated contracts.
COPY sdo/operator ./sdo/operator
RUN cd sdo/operator/sdk && go mod download all
RUN cd sdo/operator/core && go mod download all
RUN cd sdo/operator/runtime && go mod download all
RUN cd sdo/operator && go mod download all
RUN cd sdo/operator/sdk && go test -run '^$' ./...
RUN cd sdo/operator/core && go test -run '^$' ./...
RUN cd sdo/operator/runtime && go test -run '^$' ./...
RUN cd sdo/operator && go build -buildvcs=false -o /usr/local/bin/sdo-operator ./cmd/sdo-operator

FROM registry.k8s.io/kubectl:v1.33.2@sha256:15ac68dd5ff1c5ef4c5ef85f2ef1a6e20903312ed10090e0c834ca8b156e331e AS kubectl

FROM go-runtime AS controller
LABEL org.opencontainers.image.title="SDO Go operator" \
      org.opencontainers.image.version="0.1.0"
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl
ENV HOME=/tmp \
    GOCACHE=/tmp/go-cache \
    GOMODCACHE=/go/pkg/mod \
    GOPROXY=off \
    GOSUMDB=off \
    GOMAXPROCS=2 \
    GOFLAGS=-p=2
RUN find /opt/sdo/sdo/operator -name '*.py' -type f -delete \
    && chmod -R a+rX /opt/sdo/sdo/operator
CMD ["/usr/local/bin/sdo-operator", "controller", "--help"]

FROM node:22.17.0-bookworm-slim@sha256:b04ce4ae4e95b522112c2e5c52f781471a5cbc3b594527bcddedee9bc48c03a0 AS worker-runtime
ARG CODEX_VERSION=0.163.0
ARG CLAUDE_CODE_VERSION=2.1.258
LABEL org.opencontainers.image.title="SDO production runtime" \
      org.opencontainers.image.version="0.1.0"
RUN apt-get update \
    && apt-get install --yes --no-install-recommends ca-certificates git python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global "@openai/codex@${CODEX_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" \
    && npm cache clean --force
# Every package, transitive ones included, is pinned to uv.lock; --no-deps
# keeps pip from resolving anything else.
RUN python3 -m pip install --break-system-packages --no-cache-dir --no-deps \
      agentshim==0.7.0 \
      annotated-types==0.7.0 \
      protobuf==6.33.4 \
      pydantic==2.12.5 \
      pydantic-core==2.41.5 \
      pyyaml==6.0.3 \
      typing-extensions==4.15.0 \
      typing-inspection==0.4.2
ENV PATH="/usr/local/go/bin:${PATH}" \
    PYTHONPATH=/opt/sdo \
    HOME=/tmp \
    GOCACHE=/tmp/go-cache \
    GOMODCACHE=/go/pkg/mod \
    GOPROXY=off \
    GOSUMDB=off \
    GOMAXPROCS=2 \
    GOFLAGS=-p=2
COPY --from=go-runtime /usr/local/go /usr/local/go
COPY --from=go-runtime /usr/local/bin/sdo-operator /usr/local/bin/sdo-operator
COPY --from=go-runtime /go/pkg/mod /go/pkg/mod
COPY --from=go-runtime /opt/sdo/sdo/operator /opt/sdo/sdo/operator
COPY --from=kubectl /bin/kubectl /usr/local/bin/kubectl
COPY sdo /opt/sdo/sdo
COPY libs/__init__.py /opt/sdo/libs/__init__.py
COPY libs/agent_cli /opt/sdo/libs/agent_cli
RUN chmod -R a+rX /opt/sdo/sdo/operator /opt/sdo/sdo /opt/sdo/libs
WORKDIR /opt/sdo

FROM worker-runtime AS responder
RUN if output="$(/usr/local/bin/sdo-operator draft-test --app /tmp --proposal-json /missing 2>&1)"; then exit 1; fi \
    && printf '%s' "$output" | grep -q 'read typed draft'
CMD ["python3", "-m", "sdo.agents.responder.worker"]

FROM responder AS sregym-responder
# Benchmark transport clients; production images stay free of them.
RUN python3 -m pip install --break-system-packages --no-cache-dir --no-deps \
      anyio==4.12.1 \
      certifi==2026.1.4 \
      charset-normalizer==3.4.4 \
      h11==0.16.0 \
      httpcore==1.0.9 \
      httpx==0.28.1 \
      idna==3.11 \
      requests==2.32.5 \
      urllib3==2.6.3
# Only the modules the responder's entry points actually import at runtime:
# `adapter.submission` (the submission smoke test in scripts/build_sdo_images.sh) and
# `adapter.submission_relay` (the in-cluster submission bridge Deployment,
# benchmarks.sregym.adapter.runtime._submission_bridge_resources). Nothing under
# experiments/, assurance/, fastloop/, analysis/, runner/, agents/, docs/ or tests/ is
# copied: those hold the SREGym answer key (composites.toml, the assurance plan,
# assurance/scripted_codex/faults.py), which this image's `codex exec
# --danger-full-access` responder must never be able to read.
COPY benchmarks/__init__.py /opt/sdo/benchmarks/__init__.py
COPY benchmarks/sregym/__init__.py /opt/sdo/benchmarks/sregym/__init__.py
COPY benchmarks/sregym/adapter/__init__.py benchmarks/sregym/adapter/submission.py benchmarks/sregym/adapter/submission_relay.py /opt/sdo/benchmarks/sregym/adapter/
COPY benchmarks/sregym/protocol/__init__.py benchmarks/sregym/protocol/_http.py benchmarks/sregym/protocol/benchmark.py benchmarks/sregym/protocol/conductor.py benchmarks/sregym/protocol/mcp_client.py benchmarks/sregym/protocol/receipt.py benchmarks/sregym/protocol/schema.py /opt/sdo/benchmarks/sregym/protocol/
RUN chmod -R a+rX /opt/sdo/benchmarks
