[
 {
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
   "namespace": "demo",
   "name": "cart"
  },
  "spec": {
   "replicas": 1,
   "selector": {
    "matchLabels": {
     "app": "cart"
    }
   },
   "template": {
    "metadata": {
     "labels": {
      "app": "cart"
     }
    },
    "spec": {
     "containers": [
      {
       "name": "cart",
       "image": "cart:1",
       "resources": {
        "requests": {
         "cpu": "100m"
        }
       }
      }
     ]
    }
   }
  }
 }
]