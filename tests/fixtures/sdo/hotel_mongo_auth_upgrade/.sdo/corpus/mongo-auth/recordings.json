[
  {
    "method": "DatabaseUsers",
    "arguments": [
      {
        "engine": "mongodb",
        "pod": {
          "api_version": "v1",
          "kind": "Pod",
          "namespace": "demo",
          "name": "mongodb-geo"
        },
        "container": "mongo",
        "database": "geo",
        "auth": {
          "database": "admin",
          "username": {
            "config_map": {
              "name": "mongo-geo-script",
              "key": "k8s-geo-mongo.sh",
              "assignment": "ROOT_USER"
            }
          },
          "password": {
            "config_map": {
              "name": "mongo-geo-script",
              "key": "k8s-geo-mongo.sh",
              "assignment": "ROOT_PASSWORD"
            }
          }
        }
      }
    ],
    "result": [
      {
        "name": "root",
        "roles": [
          {
            "database": "admin",
            "name": "root"
          }
        ]
      }
    ]
  },
