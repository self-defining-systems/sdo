{
  "schema_version": "sdo.dev/v1alpha1",
  "agent_id": "sdo-health-judge",
  "capabilities": [
    {
      "task_type": "health-judgment-direct-v1",
      "request_type_url": "type.googleapis.com/sdodev.contracts.v1alpha1.HealthJudgeRequest",
      "result_type_url": "type.googleapis.com/sdodev.contracts.v1alpha1.HealthJudgeResult"
    }
  ],
  "kubernetes_job": {
    "image": "${RESPONDER_IMAGE}",
    "command": ["env", "python3", "-m", "benchmarks.sregym.adapter.scripted_worker", "health-judge"]
  }
}
