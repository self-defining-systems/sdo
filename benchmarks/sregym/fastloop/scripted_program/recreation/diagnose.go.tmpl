package resource_recreation

import (
 "context"

 "sdo.dev/operator/sdk/program"
)

type Program struct{}

func (Program) Spec() program.ProgramSpec {
 return program.ProgramSpec{ID: "PROGRAM_ID", Params: []program.ParamSpec{{Name:"resource", Kind:"RESOURCE_KIND", Required:true}}}
}

func (Program) Diagnose(_ context.Context, view program.ReadView, bindings program.Bindings) (program.Verdict,error) {
 ref:=bindings.Objects["resource"]
 diff,err:=view.DiffAgainstSource(ref)
 if err!=nil {return program.Verdict{Result:program.Unknown},nil}
 if diff.SourceAbsent {return program.Verdict{Result:program.NoMatch},nil}
 for _, object := range view.COLLECTION() {
  if object.Namespace==ref.Namespace && object.Name==ref.Name {return program.Verdict{Result:program.NoMatch},nil}
 }
 return program.Verdict{Result:program.Match,Evidence:[]program.Evidence{{Resource:ref,Fact:"accepted source object missing",Observed:"absent",Expected:"present"}}},nil
}
