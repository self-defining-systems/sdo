# Test-only SDO image: the given SDO image with its model CLIs replaced by the scripted Codex CLI.
#
# Everything else (agentshim, sdo/, libs/, controller/, kubectl, Go) is the base
# image's, byte for byte. The real `codex` and `claude` CLIs are deleted, so a
# pod built from this image cannot reach a model even if a turn is unplanned.
#
#   docker build -f benchmarks/sregym/assurance/Dockerfile.scripted \
#     --build-arg BASE=sdo-controller:v0.1.0 -t sdo-controller:assure .
ARG BASE
FROM ${BASE}
RUN npm uninstall --global @openai/codex @anthropic-ai/claude-code >/dev/null 2>&1; \
    rm -f /usr/local/bin/codex /usr/local/bin/claude \
    && ! command -v claude
USER root
RUN apt-get update && apt-get install -y --no-install-recommends bubblewrap \
    && rm -rf /var/lib/apt/lists/*
COPY benchmarks/sregym/agent_script/__init__.py benchmarks/sregym/agent_script/__main__.py benchmarks/sregym/agent_script/cli.py benchmarks/sregym/agent_script/converter.py benchmarks/sregym/agent_script/invocation.py benchmarks/sregym/agent_script/judge_example.py benchmarks/sregym/agent_script/model.py benchmarks/sregym/agent_script/runner.py benchmarks/sregym/agent_script/template.py benchmarks/sregym/agent_script/wire.py /opt/sdo/benchmarks/sregym/agent_script/
COPY benchmarks/sregym/assurance/__init__.py benchmarks/sregym/assurance/script_cli.py benchmarks/sregym/assurance/script_store.py benchmarks/sregym/assurance/usage.py /opt/sdo/benchmarks/sregym/assurance/
RUN printf '#!/bin/sh\nPYTHONPATH=/opt/sdo exec python3 -m benchmarks.sregym.assurance.script_cli "$@"\n' \
      > /usr/local/bin/codex \
    && chmod 0755 /usr/local/bin/codex \
    && codex --help >/dev/null
LABEL sdo.dev/agent-script="true"
