# Test-only SDO image: the given SDO image with its model CLIs replaced by the scripted Codex CLI.
#
# Everything else (agentshim, sdo/, libs/, controller/, kubectl, Go) is the base
# image's, byte for byte. The real `codex` and `claude` CLIs are deleted, so a
# pod built from this image cannot reach a model even if a turn is unplanned.
#
#   docker build -f benchmarks/sregym/assurance/Dockerfile.scripted \
#     --build-arg BASE=sdo-controller:v0.1.0 -t sdo-controller:assure .
ARG BASE
FROM ${BASE}
RUN npm uninstall --global @openai/codex @anthropic-ai/claude-code >/dev/null 2>&1; \
    rm -f /usr/local/bin/codex /usr/local/bin/claude \
    && ! command -v claude
# Test-only replay modules: ordinary benchmark/model images exclude this catalog.
COPY benchmarks/__init__.py /opt/sdo/benchmarks/
COPY benchmarks/sregym/__init__.py /opt/sdo/benchmarks/sregym/
COPY benchmarks/sregym/adapter/__init__.py benchmarks/sregym/adapter/scripted_worker.py benchmarks/sregym/adapter/scripted_replay.py benchmarks/sregym/adapter/scripted_replay_catalog.py /opt/sdo/benchmarks/sregym/adapter/
COPY benchmarks/sregym/assurance/scripted_codex /opt/sdo-scripted/scripted_codex
COPY benchmarks/sregym/fastloop/scripted_program /opt/sdo-scripted/targetport
RUN printf '#!/bin/sh\nPYTHONPATH=/opt/sdo-scripted:/opt/sdo exec python3 -m scripted_codex "$@"\n' \
      > /usr/local/bin/codex \
    && chmod 0755 /usr/local/bin/codex \
    && chmod -R a+rX /opt/sdo-scripted /opt/sdo/benchmarks \
    && codex --help >/dev/null
LABEL sdo.dev/scripted-codex="true"
